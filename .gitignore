# Self-host secrets (compose). The committed template is .env.example.
.env

# Backend runtime object storage (media_storage_dir defaults to data/storage)
/data/

# Local scratch (working pdfs, throwaway files) — never published
/tmp/

# UI prototypes & screenshot harnesses (Base UI spike, rail mockups). Throwaway by design:
# they are how a look is tried out, not how it ships — the real app is the record.
/proto/
/proto.html

# superseded static look&feel mockups (replaced by the React app at repo root)
docs/design-concepts/

# Design explorations live here, but the directory is NOT wholesale publishable: the working
# drafts carry real roster names and real Oberwil objects (they are drawn from station data
# to look right), and docs/planning/schichtbaender.md already asserts they stay local. That
# was a promise nothing enforced — one `git add -A` would have published nine of them.
# Ignore the directory, then re-admit the two that are deliberately kept as historical
# record (docs/README.md and AGENTS.md both point at them).
/mockups/*.html
!/mockups/app-lage.html
!/mockups/nav-concepts.html

# Private, station-specific deployment configs — never enter the public repo
backend/private/

# Maintainer-internal working notes & one-station policy drafts — kept locally, not published
todo.md
docs/planning/
docs/operating-rules.md
docs/data-retention.md
docs/adfu-offizier-einsatzablauf.md
docs/einsatzrapport-workflow.md
docs/testing/rapport-drill.md
PROVIDER_NEUTRAL_MIGRATION_PLAN.md

# Per-station reference geodata is station data (restricted utility cadastre, etc.) — it
# lives in a private data repo and is loaded via `admin_geodata`, never bundled here.
public/leitungskataster/
tools/symbols-new.json
