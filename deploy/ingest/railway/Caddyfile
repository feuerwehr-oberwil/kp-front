# Ingest edge, Railway flavour.
#
# Differs from deploy/ingest/Caddyfile (the VPS one) in two ways, both forced by the platform:
#   * Railway terminates TLS at its own edge, so this listens on plain HTTP on $PORT and
#     `auto_https off` — Caddy must not try to get its own certificate.
#   * GlitchTip is a private service reachable over Railway's internal network, not a
#     compose-network hostname.
#
# What does NOT change is the reason this proxy exists at all: rate limiting the public
# envelope endpoint, and making sure no client IP survives the hop into GlitchTip.

{
	auto_https off
	admin off
	order rate_limit before reverse_proxy
}

:{$PORT} {
	encode gzip

	# The public ingest endpoint. Everything else on this host is the dashboard.
	@envelope path_regexp envelope ^/api/\d+/envelope/?$

	handle @envelope {
		rate_limit {
			# Per IP: a station batches on a 5-minute timer, so this is generous for the
			# honest case and useless for flooding.
			zone per_ip {
				key {remote_host}
				events 60
				window 1m
			}
			# Per install: stops one wedged installation — or one attacker rotating through
			# addresses — from eating the project quota, which a per-IP limit alone allows.
			zone per_install {
				key {http.request.header.X-Sentry-Auth}
				events 200
				window 1h
			}
			status_code 429
		}

		# Strip every trace of who sent this before it reaches the app. The payload carries
		# no IP by construction; this makes sure the SERVER cannot add one either, and that a
		# future GlitchTip release which starts recording X-Forwarded-For finds nothing.
		request_header -X-Forwarded-For
		request_header -X-Real-IP
		request_header -Forwarded
		request_header -CF-Connecting-IP

		reverse_proxy web.railway.internal:8080 {
			header_up X-Forwarded-For ""
			header_up X-Real-IP ""
		}
	}

	# The dashboard. On a VPS this would sit on a separate hostname behind a VPN; Railway has
	# no VPN, and an error tracker whose UI is unreachable is an error tracker nobody reads.
	# So it is served here, gated by login with open registration turned OFF — which is the
	# honest trade, and PRIVACY.md says so rather than claiming a VPN that doesn't exist.
	handle {
		reverse_proxy web.railway.internal:8080
	}

	log {
		# Do not log the remote address. Header stripping above is pointless if the access
		# log quietly keeps a record of which station sent what.
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>headers delete
			}
		}
	}
}
