#!/usr/bin/env bash
# Runs the gates this branch can affect before it leaves the machine: `just ci`, scoped by
# scripts/ci-scope.mjs. Install once per clone with `just hooks`. A 3am hotfix skips it with
# `git push --no-verify`. It checks the working tree, so uncommitted edits count too.
set -euo pipefail

# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# A push that only deletes remote branches or tags has nothing to check.
# `just ci` checks the working tree, so a pushed commit other than HEAD would go out unchecked.
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
pushing=false
while read -r local_ref local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  # a tag push sends the tag object; what it checks out is its commit
  if [ "$(git rev-parse "$local_sha^{commit}")" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked-out commit – check it out to push it (or --no-verify)." >&2
    exit 1
  fi
  pushing=true
done
$pushing || exit 0

exec just ci
