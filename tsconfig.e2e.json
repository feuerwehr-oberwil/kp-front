{
  // The Playwright specs run in Node. They are type-checked on their own (ci.yml · Frontend job),
  // because the app's tsconfig.json covers src/ only and keeps Node's globals out of it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    // e2e/fat-incident.perf.ts imports the fat-incident generator, and through its types a slice
    // of src/ – which reads import.meta.env and has .tsx modules
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
