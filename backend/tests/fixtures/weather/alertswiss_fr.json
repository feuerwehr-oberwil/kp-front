:false,"banner":false,"instructions":[{"text":"Es ist verboten, im Wald und in Waldesnähe Feuer zu entfachen (Abstand zum Wald: 50m)."},{"text":"Das Verbot gilt auch für eingerichtete Feuerstellen sowie für mitgebrachte Holz-/Kohle-Grills."},{"text":"Im übrigen Kantonsgebiet ist das Feuern an unbefestigten Feuerstellen verboten."},{"text":"Les feux d’artifice sont interdits.","imageUrl":"/content/alertswiss-internet/fr/_jcr_content/i18nGeneral/pictograms/157_1537967623445/image.spoolimage.1537967623447/noresize/image.5352.png"},{"text":"Das Entfachen von Höhenfeuern ist verboten."},{"text":"Das Steigenlassen von Himmelslaternen ist verboten."},{"text":"Es ist verboten, brennende Zigaretten, andere Raucherwaren oder Streichhölzer wegzuwerfen."},{"text":"Verzichten Sie bei starken und böigen Winden auf Feuer im Freien."},{"text":"Für das Gebiet des Reussdeltas Flüelen/Seedorf gilt nach wie vor ein absolutes Feuerverbot!"}],"sender":"info@alertswiss.ch","publisherName":"Canton d'Uri","link":"https://www.alert.swiss","links":[{"href":"https://www.alert.swiss","text":"www.alert.swiss"},{"href":"https://www.ur.ch","text":"www.ur.ch"}],"contact":{"contact":"Pompiers: <a href=\"tel:118\">118</a><br/>Einsatzzentrale Polizei: <a href=\"tel:+41 41 874 53 53\">+41 41 874 53 53</a>"},"event":"Incendie de forêt","allClear":false,"severity":"moderate","testAlert":false,"technicalTestAlert":false,"publishDate":"mar., 25.08.2026, 12:04","areas":[{"description":{"description":"Kanton Uri"},"polygons":[{"coordinates":[["46.75673","8.44637"],["46.75409","8.44393"],["46.75336","8.43872"],["46.74997","8.44241"],["46.74690","8.44287"],["46.74298","8.44093"],["46.73745","8.44077"],["46.72984","8.44972"],["46.72686","8.44747"],["46.71456","8.44724"],["46.71235","8.44858"],["46.71078","8.45379"],["46.70436","8.45203"],["46.69752","8.45504"],["46.68871","8.45229"],["46.68554","8.44109"],["46.68707","8.43273"],["46.68607","8.42818"],["46.68741","8.41481"],["46.68942","8.41453"],["46.69061","8.