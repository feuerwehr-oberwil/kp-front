{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "disableTypeChecks": false,
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "mutate": [
    "src/lib/atemschutz.ts",
    "src/lib/auditEventStore.ts",
    "src/lib/eventScope.ts",
    "src/lib/jsonEqual.ts",
    "src/lib/mergeWorkspace.ts",
    "src/lib/serialQueue.ts",
    "src/lib/serverClock.ts",
    "src/lib/syncAlert.ts",
    "src/lib/undoTimeline.ts",
    "src/lib/alarm.ts",
    "src/lib/alarmReadiness.ts"
  ],
  "concurrency": 4,
  "timeoutMS": 5000,
  "reporters": ["clear-text", "progress", "html", "json"],
  "clearTextReporter": { "logTests": false },
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "tempDirName": ".x-stryker-tmp",
  "ignorePatterns": ["/.x-*", "/backend/.venv", "/coverage", "/dist"],
  "incremental": true,
  "thresholds": { "high": 90, "low": 80, "break": 78 }
}
