        "links": {
          "items": {
            "$ref": "#/$defs/ReportLinkConfig"
          },
          "maxItems": 30,
          "title": "Links",
          "type": "array"
        }
      },
      "title": "ReportConfig",
      "type": "object"
    },
    "ReportLinkConfig": {
      "description": "One row of ``ReportConfig.links``.\n\n``url`` may carry ``{platzhalter}`` tokens (``{stichwort}``, ``{ort}``, ``{datum}``,\n``{alarmzeit}``, ``{einsatzende}``, ``{einsatzleiter}``, ``{kontaktperson}``,\n``{kurzbericht}``, ``{wehr}``), which the app substitutes URL-encoded when the link is\nopened. That is how a Google Form arrives with Anlass and Datum already in it — see\n\"Link zum Vorausfüllen abrufen\" in Google Forms, which yields ``?usp=pp_url&entry.<id>=…``.\n\nThe backend does not resolve or fetch these; it stores them.\n\n⚠️ ``url`` is constrained to http(s) HERE as well, not only in the app. The frontend gate\n(``deploymentConfig · reportLinks``) protects the one consumer that exists today; a\n``javascript:`` URL accepted into the stored document would be waiting for the next one.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "id",
        "title",
        "url"
      ],
      "title": "ReportLinkConfig",
      "type": "object"
    },
    "RosterConfig": {
      "properties": {
        "source": {
          "anyOf": [
            {
              "enum": [
                "manual",
                "divera",
                "snapshot"
