{
  "$defs": {
    "AlarmGroup": {
      "description": "One station alarm group for the Alarmierungs-/Ausrückzeiten grid. `id` must match\nwhat the milestone sender uses; `tagespikett` marks the day-duty group.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "winfapAlias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winfapalias"
        },
        "tagespikett": {
          "default": false,
          "title": "Tagespikett",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "AlarmGroup",
      "type": "object"
    },
    "AlarmHighPriorityKeywords": {
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/AlarmKeywordGroup"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "title": "AlarmHighPriorityKeywords",
      "type": "object"
    },
    "AlarmKeywordCategories": {
      "description": "`pairs` is ordered: the first keyword found in an uppercased title wins.",
      "properties": {
        "pairs": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Pairs",
          "type": "array"
        }
      },
      "title": "AlarmKeywordCategories",
      "type": "object"
    },
    "AlarmKeywordGroup": {
      "description": "One reader-facing grouping of high-priority keywords. `group`/`note` are documentation\n— priority inference is an any-match, so the grouping carries no meaning at runtime.",
      "properties": {
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        }
      },
      "title": "AlarmKeywordGroup",
      "type": "object"
    },
    "AlarmKeywordsConfig": {
      "description": "A station's own alarm vocabulary — it REPLACES the shipped one wholesale.\n\nThe shape is `backend/app/data/alarm_keywords.json` verbatim, so a station starts by\ncopying that file (the documented way to add a single keyword) and pastes it under\n`alarmKeywords`. Hence the snake_case field names in here, unlike the rest of this\ndocument: they are the file's key names, not new ones. `_readme` and `schema` are accepted\nand dropped — they document the shipped file, not this deployment's row.\n\nValidity is decided ONCE, by `alarm_keywords.parse()`, the same rule the shipped file\npasses at import. There is no second schema to keep in step. On top of it, one kp-front\nrule the shared file cannot state: every category must be one this app has a German label\nfor, because a vocabulary routing to an unknown category would file those alarms under\n«Diverse Einsätze» and never say why.",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "type": "integer"
        },
        "keyword_to_category": {
          "$ref": "#/$defs/AlarmKeywordCategories"
        },
        "fallback_category": {
          "title": "Fallback Category",
          "type": "string"
        },
        "high_priority_keywords": {
          "$ref": "#/$defs/AlarmHighPriorityKeywords"
        },
        "known_matcher_divergence": {
          "$ref": "#/$defs/AlarmMatcherDivergence"
        }
      },
      "required": [
        "schema_version",
        "keyword_to_category",
        "fallback_category"
      ],
      "title": "AlarmKeywordsConfig",
      "type": "object"
    },
    "AlarmMatcherDivergence": {
      "description": "Documentation of the kp-front/kp-rueck matcher difference; carried so a station can copy\nthe shipped file verbatim. kp-front's matcher does not read it.",
      "properties": {
        "kp_rueck_word_bounded": {
          "items": {
            "type": "string"
          },
          "title": "Kp Rueck Word Bounded",
          "type": "array"
        }
      },
      "title": "AlarmMatcherDivergence",
      "type": "object"
    },
    "AlarmsConfig": {
      "description": "Alarm handling: auto-open incidents from incoming alarms + auto-archive of untouched\nauto-opened ones.",
      "properties": {
        "autoOpen": {
          "default": false,
          "title": "Autoopen",
          "type": "boolean"
        },
        "autoOpenPriorities": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "HIGH",
                  "LOW"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autoopenpriorities"
        },
        "autoOpenKeywords": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autoopenkeywords"
        },
        "autoArchiveDays": {
          "default": 7,
          "minimum": 0,
          "title": "Autoarchivedays",
          "type": "integer"
        },
        "staleIncidentDays": {
          "default": 30,
          "minimum": 0,
          "title": "Staleincidentdays",
          "type": "integer"
        },
        "captureWindowHours": {
          "default": 12,
          "maximum": 168,
          "minimum": 1,
          "title": "Capturewindowhours",
          "type": "integer"
        },
        "webhooks": {
          "items": {
            "type": "string"
          },
          "title": "Webhooks",
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/AlarmGroup"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "title": "AlarmsConfig",
      "type": "object"
    },
