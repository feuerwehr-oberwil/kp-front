    "ReportConfig": {
      "description": "Einsatzrapport form presets. `partnerOrgs` feeds the Partnerorganisationen\ncheckbox row (paper Erfassungsblatt + rapport form quick-pick); free-text entries\nremain possible everywhere. Empty = no preset row.",
      "properties": {
        "partnerOrgs": {
          "items": {
            "type": "string"
          },
          "title": "Partnerorgs",
          "type": "array"
        },
        "reversePrintOrder": {
          "default": true,
          "title": "Reverseprintorder",
          "type": "boolean"
        },
        "hoursRounding": {
          "$ref": "#/$defs/HoursRoundingConfig"
        },
        "attendanceMergeGapMin": {
          "default": 15,
          "maximum": 240,
          "minimum": 0,
          "title": "Attendancemergegapmin",
          "type": "integer"
