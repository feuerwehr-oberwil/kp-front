# Self-host configuration for docker-compose (one fire station = one deployment).
# Copy to .env and fill in the FOUR values under `--- Required ---`. Railway deploys ignore
# this file.
#
#   ./scripts/setup.sh       # the install: domain, port, nightly backup → .env + a running
#                            # stack + the integration secrets in the credential store
#   ./scripts/init-env.sh    # or just this file, with all four generated
#   docker compose up -d
#
# By hand instead: `cp .env.example .env`, then fill in all four – SEED_PIN included, it is the
# one that gets read past. Empty POSTGRES_PASSWORD or SECRET_KEY: compose refuses to start and
# names them. Empty SEED_PIN: nobody can log in – see below. Empty ADMIN_SECRET: everything
# runs, but /admin is disabled and nothing says so.

# --- Required (all four) -----------------------------------------------------------
# Postgres password for the bundled db service (any strong value; used on first boot).
# Left EMPTY on purpose, like the other three: `docker-compose.yml` guards it with `${VAR:?}`,
# so an unfilled value stops the stack and names the variable. A placeholder here would have
# satisfied that guard, and the by-hand path would have shipped a password published in a
# public repo — the one Required value where forgetting used to be silent.
POSTGRES_PASSWORD=
# Signs JWTs, peppers PINs, AND encrypts the integration credentials stored in the database —
# keep it STABLE. Changing it logs everyone out, breaks every PIN, and makes every stored
# credential (Divera, Traccar, Web Push, …) unreadable: they report as «unlesbar, bitte neu
# setzen» and that integration is off until it is set again. Back it up with your secrets.
# Generate: openssl rand -hex 32
SECRET_KEY=
# Unlocks the /admin UI + admin-write API/CLI (config, branding, users, geodata/objects) —
# SEPARATE from the incident editor PIN. Generate: openssl rand -hex 24. Empty = admin
# surface DISABLED (fail-closed). Required to administer this deployment.
ADMIN_SECRET=
# The PIN of the FIRST account – user "fu" (Führungsunterstützung), role editor – seeded on
# first boot. Exactly six digits, and not one of the obvious ones (000000, 123456, …).
#
# ⚠️ Leave it empty and NOBODY CAN LOG IN – in one of two shapes, depending on which image you
# run: current releases refuse to boot and restart-loop, while the old v0.6.0 image came up
# green with an empty roster. Both shapes and the one fix are side by side
# in docs/SETUP.md §1; the restart loop is also docs/DEPLOYMENT.md §8. Change it after login.
#
# Alternative: set SEED_DATABASE=false below and create the first account through the admin UI.
SEED_PIN=

# --- Version ----------------------------------------------------------------------
# Which published image to run: a pinned release (X.Y.Z), a minor series that follows
# patches (X.Y), or the newest release (latest, the default). Update with
# `docker compose pull && docker compose up -d`; roll back by pinning the previous version.
# Release notes: https://github.com/feuerwehr-oberwil/kp-front/releases
KP_FRONT_TAG=latest

# --- Networking -------------------------------------------------------------------
# Host port the app listens on (plain HTTP). Put a reverse proxy / the tls profile in front.
#
# ⚠️ It has to be FREE on this host. Anything else already bound to 8000 – a KP Rück stack,
# another compose project, a stray dev server – and `docker compose up -d` dies with
# `Bind for 0.0.0.0:8000 failed: port is already allocated`. Nothing is broken; pick another
# port (8100, 8001, …) here and try again. Check first: `ss -tlnp | grep :8000`.
APP_PORT=8000
# Which host address that port is published on. Docker publishes ports by writing its own
# NAT rules, which are consulted BEFORE ufw's – so `ufw deny 8000` does not close a published
# port. This is the knob that does.
#   0.0.0.0     reachable from the LAN – the plain-HTTP-on-a-trusted-LAN shape (the default)
#   127.0.0.1   loopback only – use this whenever something terminates TLS in front of the
#               app: the tls profile (Caddy reaches it over the compose network, not through
#               this port) or your own reverse proxy on the same host. Without it the app is
#               also served in plaintext straight past the proxy.
APP_BIND=0.0.0.0
# Running a KP Rück stack on this host too? Only one of them can own 443 — run this one
# WITHOUT `--profile tls` and let one outer proxy terminate TLS for both:
#   https://github.com/feuerwehr-oberwil/kp-rueck/blob/main/docs/RUNNING-BOTH.md
# (Its app port collides just as readily – give the two stacks different APP_PORTs.)
# Force-disable Secure cookies for plain-HTTP access on a trusted LAN (no domain/TLS).
# Leave blank when serving over HTTPS. Values: true | false
COOKIE_SECURE=

# --- Automatic HTTPS (only used with: docker compose --profile tls up -d) ----------
# Domain whose A/AAAA record points at this host. Caddy gets a cert automatically.
DOMAIN=

# --- Database identity (optional; defaults shown) ----------------------------------
POSTGRES_USER=kpfront
POSTGRES_DB=kpfront

# --- Seeding ----------------------------------------------------------------------
# First boot seeds the default editor from backend/app/seed_users.json — user "fu"
# (Führungsunterstützung), role editor. Idempotent.
# Its PIN is SEED_PIN, up in `--- Required ---`: mandatory while this is true, because the
# PIN in the seed file is 000000 and is printed in the README. Set this to false only if you
# would rather create the first account through the admin UI.
SEED_DATABASE=true

# --- Optional integrations (leave blank to disable) --------------------------------
#
# ⚠️ READ THIS ONCE, IT APPLIES TO EVERY VARIABLE IN THIS SECTION. Sixteen of them can also
# be set from a browser at /admin → Zugangsdaten, where they are stored encrypted in the
# database and can be rotated at 03:00 without SSH. THIS FILE WINS: a variable with a value
# here is what the app uses, and its browser field then reports itself as server-set and
# refuses to save (409). So leaving a line blank does not mean «off» — it means «whoever
# administers this station decides, from the admin page». Fill one in only when you want the
# environment, and nobody else, to own that value.
#
# Divera 24/7 (alarms / roster)
DIVERA_ACCESS_KEY=
# Optional: a second accesskey whose Divera user can read members' Qualifikationen — enables
# deriving each crew member's Dienstgrad (rank) during roster sync. Empty = names only.
DIVERA_PERSONNEL_ACCESS_KEY=
# Required to receive push alarms via /api/divera/webhook — the webhook rejects everything
# (403) while this is empty, so nobody can inject fake alarms. Polling works without it.
#
# ⚠️ EMPTY HERE ON PURPOSE, and it stays empty after ./scripts/setup.sh has run. The installer
# does generate this one (and ALARM_WEBHOOK_SECRET below) — into the ENCRYPTED CREDENTIAL
# STORE, not into this file. Read it, change it or clear it at /admin → Zugangsdaten.
# A value written HERE outranks the stored one (app/credentials.py: the environment wins) and
# the browser field then refuses to save at all, so fill it in only if you deliberately want
# this deployment's environment to own it.
DIVERA_WEBHOOK_SECRET=

# Generic alarm intake for non-Divera alerting systems: POST /api/alarms auto-opens an
# incident per alarm (idempotent on source+source_id). Empty = endpoint disabled (403).
# Also generated into the credential store by ./scripts/setup.sh — see the note above.
ALARM_WEBHOOK_SECRET=
# Public origin (https://front.example.org) for absolute links in outbound incident
# webhooks (docs/ALARM-INTEGRATIONS.md). Empty = links omitted.
# NOT the same thing as KP Rück's PUBLIC_URL, which is its allowed CORS origin (and is called
# CORS_ORIGINS there since 0.2). Copying one stack's .env to the other as a starting point
# breaks CORS with no error message — see RUNNING-BOTH.md, linked above.
PUBLIC_URL=

# Web Push (killed-app Atemschutz/Wiedervorlage alarms + new-alarm push).
#
# ⚠️ EMPTY HERE ON PURPOSE, and still empty after ./scripts/setup.sh has run: the installer
# generates the pair in the app container and stores it ENCRYPTED IN THE DATABASE, where
# /admin → Zugangsdaten can rotate it at 03:00 without a terminal. A key written here wins
# over the stored one and turns those fields read-only in the browser.
#
# To generate a pair by hand anyway — on a host that has nothing but Docker, which is the
# whole list SETUP.md asks for:
#   docker compose exec app uv run python -m app.gen_vapid
# (`cd backend && uv run python -m app.gen_vapid` if you have the uv toolchain; the image
# already carries it, which is why the line above needs nothing installed.) Paste both keys,
# URL-safe base64, into /admin → Zugangsdaten — pasting them here instead also works, but
# then .env is read once at process start, so it needs `docker compose up -d` afterwards.
#
# Nothing set anywhere = push disabled; in-app alarms still work, but nothing reaches a tablet
# whose screen is off. Generate ONCE and keep the pair stable: rotating it invalidates every
# stored subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push-service operators (mailto: or https:), printed in every push claim.
# ⚠️ Empty here is not «no contact»: it means «unset», and unset resolves to the application's
# own default, mailto:kp-front@localhost. Writing anything else here — including a plausible
# placeholder — is read as a deployer's decision and locks the field in the browser.
VAPID_SUBJECT=
# Traccar (live vehicle GPS)
TRACCAR_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=

# Station print relay: «An Stationsdrucker» queues the Einsatzrapport-PDF for an on-site
# polling agent — it lives in the kp-rueck repository now (see tools/PRINT-AGENT.md; the
# published image is ghcr.io/feuerwehr-oberwil/kp-print-agent and it serves both apps).
# Empty = agent endpoints 403 (fail-closed).
#
# ⚠️ Deliberately NOT pre-generated by ./scripts/setup.sh, unlike the two webhook secrets
# above — and the reason is no longer the scheduler. Its sweep is registered unconditionally
# now and returns on the first line when no secret is set (app/scheduler.py), so an unused
# value costs nothing there. What it costs is on screen: this secret IS the switch that makes
# the relay «configured», so minting it renders «An Stationsdrucker» in the Rapport and on the
# capture poster for every station that owns no printer, and puts a permanently offline
# connector on the System card. A button that queues paper nobody collects is worse than an
# absent one. It also saves nobody anything — the agent lives on a second machine that has to
# be set up at a terminal anyway. Generate it there:  openssl rand -hex 32
# …or set it from a browser at /admin → Zugangsdaten, which is where you paste the agent's
# copy of it. As with everything above, a value in THIS file outranks that page.
PRINT_AGENT_SECRET=

# Speech-to-text for the audio player's Transkribieren (OpenAI-compatible
# /v1/audio/transcriptions server, base URL WITHOUT /v1):
#   Groq (free tier):  STT_BASE_URL=https://api.groq.com/openai   STT_MODEL=whisper-large-v3-turbo
#   OpenAI:            STT_BASE_URL=https://api.openai.com        STT_MODEL=whisper-1
#   self-hosted (speaches/faster-whisper-server): STT_BASE_URL=http://host:8000, key optional
# Empty base URL = STT off everywhere (fail-closed). Audio leaves the instance only when set.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=de

# CARTO raster basemaps (Voyager + Dark Matter) require a browser key. Request one for
# this deployment's domains at https://carto.com/basemaps/apikey/ and paste it here, or set
# it in /admin → Zugangsdaten. The key is necessarily visible in browser tile requests, so
# ⚠️ RESTRICT IT TO THE DEPLOYMENT DOMAINS in CARTO — that restriction, not secrecy, is what
# stops it being spent elsewhere. Never commit a real value.
#
# The app hands it out only to a caller that already has a session (PIN user, admin, or an
# incident link); the login screen draws no map and does not receive it. Rapport/Kroki tiles
# are fetched by the SERVER with this same key, so it never travels in a request body.
CARTO_API_KEY=

# Objektplan-Pull: let this deployment FETCH its Modul-PDFs from an S3-compatible bucket
# on a schedule, instead of a plan-library system pushing them in with your ADMIN_SECRET.
# Works with any S3-compatible store (MinIO, Backblaze B2, a hosted bucket, AWS) — nothing
# about a provider is built in. A READ-ONLY key is enough. The bucket must hold
# `plans/index.json` (checksums, no bytes) and `plans/<object-id>/<module>.pdf`; the format
# is in docs/objektplaene-architecture.md. Blank endpoint = no pull, nothing scheduled.
PLANS_S3_ENDPOINT=
PLANS_S3_BUCKET=
# Optional key prefix inside the bucket, e.g. kp-front/ — leave blank for the bucket root.
PLANS_S3_PREFIX=
# Signing region, verbatim from your provider's docs: a real region for some services, a
# fixed literal for others, ignored by others still.
PLANS_S3_REGION=us-east-1
PLANS_S3_ACCESS_KEY_ID=
PLANS_S3_SECRET_ACCESS_KEY=

# --- Tuning (optional; defaults shown) ---------------------------------------------
# How often to re-read the plan index. Only changed checksums are downloaded, so this is
# one small GET most of the time.
PLANS_PULL_INTERVAL_MINUTES=60
# Request-body cap for multipart uploads in MB — must stay above the media endpoint's
# 100 MB per-file cap.
MAX_UPLOAD_MB=110
# swisstopo SearchServer for address autocomplete. Not a generic-geocoder swap point —
# override only with an endpoint speaking the same SearchServer API.
GEOCODER_URL=https://api3.geo.admin.ch/rest/services/api/SearchServer

# --- Fehlerberichte / telemetry (opt-in, default OFF) -------------------------------
# Nothing is transmitted until an admin switches it on in System & Wartung — see PRIVACY.md.
# This variable is the DEPLOYER's veto and outranks that switch: set it to 0 and the forwarder
# is compiled out of the process, so no later click in the admin UI can enable it.
KP_TELEMETRY_ENABLED=1
# Where opted-in reports go. Defaults to the maintainer's ingest (a public, write-only Sentry
# key — see backend/app/telemetry/dsn.py). Point it at your own GlitchTip to keep reports
# in-house, or blank it for the same effect as KP_TELEMETRY_ENABLED=0.
KP_TELEMETRY_DSN=


# --- Besuchsstatistik / visit statistics (default OFF, and it stays off) ------------
# Counts page views, demo visits and coarse feature usage into two aggregate tables — no
# per-hit rows, no cookies, no geo, no third party. It exists for ONE deployment: the public
# demo at demo.kp-front.ch, where the maintainers need to know whether anybody is looking.
#
# ⚠️ A station has no reason to set this, and leaving it unset is not a compromise: unset
# means nothing is counted at all, not that counting happens somewhere local. Read
# backend/app/visits.py before turning it on anywhere — it also decides which browsers may
# post to /api/hit, and it is a per-deployment decision with a privacy promise attached
# (PRIVACY.md § «The project website»).
VISIT_STATS=false

# --- Map data services -------------------------------------------------------------
# Overpass mirrors for the «Umrisse» building-outline surface, comma-separated, https only,
# raced fastest-first. Called by the BACKEND (never the browser). The query is a bounding box
# around the incident, so it leaves the station — see PRIVACY.md.
# Empty = the surface is switched off. Point it at your own Overpass to keep it in-house.
# Default includes maps.mail.ru (hosted in Russia); drop it here if that is not acceptable.
# Commented out on purpose: an EMPTY value means "off", not "default". Uncomment and
# list the mirrors you want, or leave it blank to disable the surface entirely.
# OVERPASS_MIRRORS=https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Weather uses national MeteoSwiss observations plus Open-Meteo for the point-based weather
# code and as fallback. The Open-Meteo request carries the incident coordinate. Commented out
# means the default endpoint; uncomment with an EMPTY value to disable weather entirely.
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Backups -------------------------------------------------------------------------
# How many of each backup file `./scripts/backup.sh` keeps — that many database dumps AND
# that many storage tarballs, the newest ones. 14 is two weeks of nightlies.
#
# Size it from your disk, not from a feeling: each night keeps one compressed dump plus one
# tarball of everything in the storage volume (photos, voice memos, plan PDFs), so 14 nights
# of a 2 GB volume is ~28 GB. `du -sh` the backup directory after a week and adjust.
#
# ⚠️ Retention is the ONLY thing this number does. It does not make a copy off this machine,
# and 14 backups on the disk that just died are 0 backups. The schedule itself is a crontab
# line on the host — `./scripts/setup.sh --backup-cron` installs it, docs/DEPLOYMENT.md §6
# has it in full, and nothing inside the container can do this job.
BACKUP_KEEP=14

# --- Knowing when it is down --------------------------------------------------------
# A dead-man's switch. The app pings this URL every 60 s while it is alive; the monitor
# alerts YOU when the pings stop. That is the difference between learning the app is down
# from a monitor and learning it from an Einsatzleiter holding a tablet at 03:00.
#
# ⚠️ Nothing else tells you. `restart: unless-stopped` reacts to a container that EXITS,
# not to one that is unhealthy — a container answering 503 because the disk is full stays
# up and stays broken, and the compose healthcheck has no consumer that alerts.
#
# Free and enough: create a check at https://healthchecks.io and paste its ping URL here.
# Match the check to the 60 s ping: period 1 min, grace ~3 min (the grace absorbs a dropped
# ping – a failed one is swallowed, so the next attempt is 60 s later). A 5 min period is not
# wrong, it just means five extra minutes of not knowing. Any equivalent (Uptime Kuma push,
# cron-monitor) works.
# Empty = disabled, and you have no automatic way to find out.
#
# Settable without a terminal at /admin → Zugangsdaten (the «Einrichtung» card on the admin
# landing page links straight to it). Same rule as everywhere above: a value in this file wins
# and makes that field read-only.
HEALTHCHECK_PING_URL=
